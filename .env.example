# Server Configuration
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/harvest-bridge

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI Services (optional - app works in demo mode without these)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Map Services (optional - app uses card fallback without this)
MAP_API_KEY=

# Demo Mode (set to true for hackathon demo without real API keys)
DEMO_MODE=true

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
